<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons"
                    oor:package="org.openoffice.Office">
    <node oor:name="AddonUI">
        <node oor:name="OfficeMenuBar">
            <node oor:name="org.libreoffice.ai.assistant.menubar" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string">
                    <value>AI Assistant</value>
                </prop>
                <prop oor:name="Target" oor:type="xs:string">
                    <value>_self</value>
                </prop>
                <node oor:name="Submenu">
                    <node oor:name="m1" oor:op="replace">
                        <prop oor:name="URL" oor:type="xs:string">
                            <value>service:org.libreoffice.ai.assistant.AiAddon?analyze</value>
                        </prop>
                        <prop oor:name="Title" oor:type="xs:string">
                            <value>⚡ Analyze Document</value>
                        </prop>
                        <prop oor:name="Target" oor:type="xs:string">
                            <value>_self</value>
                        </prop>
                    </node>
                    <node oor:name="m2" oor:op="replace">
                        <prop oor:name="URL" oor:type="xs:string">
                            <value>service:org.libreoffice.ai.assistant.AiAddon?report</value>
                        </prop>
                        <prop oor:name="Title" oor:type="xs:string">
                            <value>📄 Generate Quality Report</value>
                        </prop>
                        <prop oor:name="Target" oor:type="xs:string">
                            <value>_self</value>
                        </prop>
                    </node>
                    <node oor:name="m3" oor:op="replace">
                        <prop oor:name="URL" oor:type="xs:string">
                            <value>service:org.libreoffice.ai.assistant.AiAddon?show_report</value>
                        </prop>
                        <prop oor:name="Title" oor:type="xs:string">
                            <value>📋 Show Report in Document</value>
                        </prop>
                        <prop oor:name="Target" oor:type="xs:string">
                            <value>_self</value>
                        </prop>
                    </node>
                </node>
            </node>
        </node>
        <node oor:name="OfficeToolBar">
            <node oor:name="org.libreoffice.ai.assistant.toolbar" oor:op="replace">
                <node oor:name="t1" oor:op="replace">
                    <prop oor:name="URL" oor:type="xs:string">
                        <value>service:org.libreoffice.ai.assistant.AiAddon?analyze</value>
                    </prop>
                    <prop oor:name="Title" oor:type="xs:string">
                        <value>AI Document Assistant</value>
                    </prop>
                    <prop oor:name="Target" oor:type="xs:string">
                        <value>_self</value>
                    </prop>
                    <prop oor:name="Context" oor:type="xs:string">
                        <value>com.sun.star.text.TextDocument</value>
                    </prop>
                </node>
                <node oor:name="t2" oor:op="replace">
                    <prop oor:name="URL" oor:type="xs:string">
                        <value>service:org.libreoffice.ai.assistant.AiAddon?show_report</value>
                    </prop>
                    <prop oor:name="Title" oor:type="xs:string">
                        <value>Show Report</value>
                    </prop>
                    <prop oor:name="Target" oor:type="xs:string">
                        <value>_self</value>
                    </prop>
                    <prop oor:name="Context" oor:type="xs:string">
                        <value>com.sun.star.text.TextDocument</value>
                    </prop>
                </node>
            </node>
        </node>
    </node>
</oor:component-data>